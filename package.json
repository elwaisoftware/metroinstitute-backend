{
  "name": "metro-institute-backend",
  "version": "1.0.0",
  "description": "Metro Institute Platform - Express.js Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:reset": "node node_modules/prisma/build/index.js db push --force-reset && npm run db:seed",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "keywords": [],
  "author": "Metro Institute",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "midtrans-client": "^1.4.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "resend": "^6.32.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/midtrans-client": "^1.4.0",
    "@types/multer": "^2.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
